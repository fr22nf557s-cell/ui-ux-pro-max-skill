// Cloudflare Worker config: serves the built site (_site/) as static assets and runs the
// Stripe checkout at /session. Build: bash build.sh · Deploy: npx wrangler deploy
// Runtime settings (Worker → Settings → Variables and Secrets): STRIPE_SECRET_KEY (secret), SITE_URL.
{
  "name": "norvexgaming",
  "main": "checkout/entry.js",
  "compatibility_date": "2026-09-01",
  // Runtime settings. SITE_URL lives here; STRIPE_SECRET_KEY is a secret added once in the
  // dashboard (Settings → Variables and Secrets) and kept across deploys (keep_vars).
  "vars": { "SITE_URL": "https://norvexgaming.com" },
  "keep_vars": true,
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The checkout route must reach the Worker for every kind of request. Without this, a browser
    // navigating to /session (the health check) is answered by the assets layer with the 404 page.
    "run_worker_first": ["/session", "/session/*"]
  },
  "observability": { "enabled": true }
}
